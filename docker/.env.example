# Copy to docker/.env (gitignored) and set throw-away DEV values. Never use real or Azure secrets here.
# Use with: docker compose --env-file docker/.env ...   (or docker/dc.sh ...)
DB_NAME=suitecrm
DB_USER=suitecrm
DB_PASSWORD=change-me-dev-only
DB_ROOT_PASSWORD=change-me-root-dev-only
# SuiteCRM admin created by the CLI installer
SITE_ADMIN_USER=admin
SITE_ADMIN_PASSWORD=change-me-admin-dev-only
# Optional host ports (not secrets). Defaults shown. Change them to run a second instance (X7):
#   APP_PORT=8082 DB_PORT=3308 MAILPIT_UI_PORT=8026 docker compose -p tkc-spike --env-file docker/.env up -d
# APP_PORT=8081
# DB_PORT=3307
# MAILPIT_UI_PORT=8025
