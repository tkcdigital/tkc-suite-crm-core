# Symfony Logs
/logs/
!logs/.gitkeep

# Symfony Cache
/cache/

# Nx Cache
/.nx/

# Dependencies
node_modules

# Compiled Output
# /public/ itself is build output, but public/legacy is tracked source (TKC: un-ignored
# so new legacy customizations in public/legacy/custom/ can be committed).
/public/*
!/public/legacy/
/public/legacy/vendor/
/dist/

# Tmp
/tmp/
!/tmp/.gitkeep

# Custom
# TKC: our own extension (extensions/tkc) is versioned; other extensions stay ignored.
/extensions/*
!/extensions/.gitkeep
!/extensions/defaultExt/
!/extensions/tkc/
/extensions/tkc/public/
!extensions/defaultExt/app
!extensions/defaultExt/backend
!extensions/defaultExt/config

# Tests
tests/_output/
tests/_support/_generated/
!tests/_output/.gitkeep
!tests/_support/_generated/.gitkeep

# Composer
composer.phar

# htacess
/.htaccess

# SASS
# /public/legacy/themes/suite8/css/Dawn/style.css
# /public/legacy/themes/suite8/css/Noon/style.css

# TKC project
/data/
CLAUDE.md
CLAUDE_SETUP_APPROACH.md
PROJECT_SETUP.md
/.claude/
/.claude/*.secrets
/.claude/settings.local.json
/.claude/worktrees/
/.claude/scripts/*.env
/.curl_check_main_page
/.installed_checked
/.yarn/
.DS_Store
/public/legacy/.installed_checked

# Docker dev environment (secrets and container state stay local)
/docker/.env
/docker/state/

# Python bytecode and test coverage output (SUITE-177)
__pycache__/
*.pyc
/coverage/
